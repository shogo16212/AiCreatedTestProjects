<Window x:Class="EchoShelf_1.EditShelfWindow1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EchoShelf_1"
        mc:Ignorable="d"
        Style="{StaticResource Default}"
        WindowStartupLocation="CenterScreen"
        Title="EditShelfWindow1" Height="300" Width="500">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition />
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Image Source="/Images/logo.png" Height="70"/>

        <StackPanel Grid.Row="1" Background="{StaticResource Primary}" Height="10"/>

        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Shelf Name:" Width="150"/>
                <TextBox x:Name="shelfTextBox" Width="200"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Description:" Width="150"/>
                <TextBox x:Name="descriptionTextBox" Width="200"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Display Order:" Width="150"/>
                <TextBox x:Name="orderTextBox" Width="200"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Width="100" x:Name="submitButton" Click="submitButton_Click" Content="Submit" Margin="5"/>
            <Button Width="100" x:Name="cancelButton" Click="cancelButton_Click" Content="Cancel" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
