<Window x:Class="EchoShelf_1.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EchoShelf_1"
        mc:Ignorable="d"
        Style="{StaticResource Default}"
        WindowStartupLocation="CenterScreen"

        Title="MenuWindow" Height="800" Width="1200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>

        <Image Source="/Images/logo.png" Height="70"/>

        <Image Source="/Images/logo.png" Height="40" HorizontalAlignment="Right" Margin="5"/>

        <StackPanel Grid.Row="1" Background="{StaticResource Primary}" Height="10"/>

        <StackPanel Orientation="Horizontal" Grid.Row="2">
            <Button x:Name="homeButton" Click="homeButton_Click" Content="Home" Margin="5" Width="100"/>
            <Button x:Name="shelveButton" Click="shelveButton_Click" Content="Display shelf" Margin="5" Width="100"/>
            <Button x:Name="analysisButton" Click="analysisButton_Click" Content="Analysis" Margin="5" Width="100"/>
            <Button x:Name="profileButton" Click="profileButton_Click" Content="Profile" Margin="5" Width="100"/>
        </StackPanel>

        <Frame Grid.Row="3" Margin="5" x:Name="frame" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
