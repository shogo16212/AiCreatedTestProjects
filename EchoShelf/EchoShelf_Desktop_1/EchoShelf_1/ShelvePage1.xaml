<Page x:Class="EchoShelf_1.ShelvePage1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EchoShelf_1"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ShelvePage1">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition />
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Shelf" Margin="5"/>

        <ComboBox Grid.Row="1" HorizontalAlignment="Left" x:Name="shelfComboBox" SelectionChanged="shelfComboBox_SelectionChanged" DisplayMemberPath="ShelfName" Margin="5" Width="200"/>
        <Button Width="100" x:Name="addButton" Click="addButton_Click" Content="New Shelf" Margin="5" HorizontalAlignment="Right" Grid.Row="1"/>

        <ListBox x:Name="listBox" Grid.Row="2" SelectionChanged="listBox_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Image Source="{Binding aa}" Margin="5" Width="100" Height="200"/>
                        <TextBlock Text="{Binding Memory.Title}" Margin="5"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <Button x:Name="editButton" Click="editButton_Click" Content="Edit" Grid.Row="3" HorizontalAlignment="Center" Margin="5" Width="100"/>
    </Grid>
</Page>
