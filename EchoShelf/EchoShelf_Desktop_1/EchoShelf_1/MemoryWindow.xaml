<Window x:Class="EchoShelf_1.MemoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EchoShelf_1"
        mc:Ignorable="d"
        Style="{StaticResource Default}"
        WindowStartupLocation="CenterScreen"
        Title="MemoryWindow" Height="700" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition />
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Image Source="/Images/logo.png" Height="70"/>

        <StackPanel Grid.Row="1" Background="{StaticResource Primary}" Height="10"/>

        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Title:" Width="150"/>
                <TextBox x:Name="titleTextBox" Width="200"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Category:" Width="150"/>
                <ComboBox x:Name="categoryComboBox" Width="200" DisplayMemberPath="CategoryName"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Memory Date:" Width="150"/>
                <DatePicker x:Name="memoryDatePicker" Width="200"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Tags:" Width="150"/>
                <ComboBox x:Name="tagsComboBox" Width="200" DisplayMemberPath="TagName"/>
                <Button x:Name="addButton" Content="Add" Click="addButton_Click"/>
            </StackPanel>
            <ListBox x:Name="tagListBox" HorizontalAlignment="Center" Width="200" Height="100">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding TagName}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Image:" Width="150"/>
                <Button x:Name="openButton" Content="Open" Click="openButton_Click"/>
            </StackPanel>
            <Image Height="100" HorizontalAlignment="Center" Margin="5" x:Name="iconImageView"/>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Episode:" Width="150"/>
                <TextBox x:Name="episodeTextBox" Width="200"/>
            </StackPanel>

            <CheckBox x:Name="favoriteCheckBox" Content="Favorite" Margin="5" HorizontalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Name="submitButton" Click="submitButton_Click" Content="Submit" Margin="5"/>
            <Button Visibility="Collapsed" Name="addShelveButton" Click="addButton_Click_1" Content="Add to Shelve" Margin="5"/>
            <Button Visibility="Collapsed" Name="removeButton" Click="removeButton_Click" Content="Remove" Margin="5"/>
            <Button Name="cancelButton" Click="cancelButton_Click" Content="Cancel" Margin="5"/>
        </StackPanel>

    </Grid>
</Window>
