<Window x:Class="EchoShelf_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EchoShelf_1"
        mc:Ignorable="d"
        Style="{StaticResource Default}"
        WindowStartupLocation="CenterScreen"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>
        
        <Image Source="/Images/logo.png" Height="70"/>

        <StackPanel Grid.Row="1" Background="{StaticResource Primary}" Height="10"/>

        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Email:" Width="150"/>
                <TextBox x:Name="emailTextBox" Width="200"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Password:" Width="150"/>
                <PasswordBox x:Name="passBox" Width="200"/>
            </StackPanel>
            <CheckBox HorizontalAlignment="Center" Margin="5" x:Name="keepCheckBox" Content="Keep Login"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Name="loginButton" Click="loginButton_Click" Content="Login" Margin="5"/>
                <Button Name="createButton" Click="createButton_Click" Content="Create User" Margin="5"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
