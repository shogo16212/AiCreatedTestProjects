<Window x:Class="SilentMoment_1.Window3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SilentMoment_1"
        mc:Ignorable="d"
        Style="{StaticResource Default}"
        WindowStartupLocation="CenterScreen"
        Title="Tag Management" Height="450" Width="800">
    <Grid>
        <DataGrid x:Name="dg1" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="82,10,82,125" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding TagName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <Label Content="New Tag name" HorizontalAlignment="Left" Margin="82,331,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="tb1" HorizontalAlignment="Left" Margin="230,335,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="312"/>
        <Button x:Name="b1" Content="Add" HorizontalAlignment="Left" Margin="82,383,0,0" VerticalAlignment="Top" Click="b1_Click"/>

    </Grid>
</Window>
