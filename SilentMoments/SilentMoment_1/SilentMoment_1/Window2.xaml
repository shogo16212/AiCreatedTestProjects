<Window x:Class="SilentMoment_1.Window2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SilentMoment_1"
        mc:Ignorable="d"
        Style="{StaticResource Default}"
        WindowStartupLocation="CenterScreen"
        Title="Window2" Height="450" Width="800">
    <Grid>
        <Label Content="Silent Moment List" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
        <Label Content="Filter" HorizontalAlignment="Left" Margin="10,41,0,0" VerticalAlignment="Top"/>
        <Label Content="From" HorizontalAlignment="Left" Margin="176,39,0,0" VerticalAlignment="Top"/>
        <Label Content="To" HorizontalAlignment="Center" Margin="0,39,0,0" VerticalAlignment="Top"/>
        <ComboBox x:Name="c2" HorizontalAlignment="Left" Margin="51,43,0,0" VerticalAlignment="Top" Width="120" SelectionChanged="c2_SelectionChanged"/>
        <DatePicker x:Name="d1" HorizontalAlignment="Left" Margin="229,42,0,0" VerticalAlignment="Top" Width="143" SelectedDateChanged="d1_SelectedDateChanged"/>
        <DatePicker x:Name="d2" HorizontalAlignment="Left" Margin="446,43,0,0" VerticalAlignment="Top" Width="143" SelectedDateChanged="d2_SelectedDateChanged"/>
        <DataGrid x:Name="dg1" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="11,74,10,10" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Place" Width="*" Binding="{Binding Place.PlaceName}"/>
                <DataGridTextColumn Header="Level" Width="*" Binding="{Binding QuietLevel}"/>
                <DataGridTextColumn Header="Date" Width="*" Binding="{Binding RecordedAt, StringFormat=yyyy-MM-dd}"/>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Window>
